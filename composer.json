{
  "name": "profesia/ddd-backbone",
  "type": "library",
  "license": "MIT",
  "description": "Set of classes helping to lay the foundation for a DDD application",
  "authors": [
    {
      "name": "Matej Bádal",
      "email": "matej.badal@profesia.sk"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/profesia/messaging-core-contracts"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "profesia/messaging-core-contracts": "dev-main",
    "doctrine/orm": "^2.13 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Profesia\\DddBackbone\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Profesia\\DddBackbone\\Test\\": "tests/"
    }
  },
  "require-dev": {
    "mockery/mockery": "^1.2",
    "squizlabs/php_codesniffer": "^3.5",
    "phpstan/phpstan": "^1.0.0",
    "phpstan/phpstan-strict-rules": "^1.0.0",
    "pestphp/pest": "^1.22",
    "ramsey/uuid": "^4.2"
  },
  "archive": {
    "exclude": [
      "docs",
      "tests"
    ]
  },
  "scripts": {
    "test": "XDEBUG_MODE=coverage ./vendor/bin/pest",
    "coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage",
    "analyse": "phpstan analyse src"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
